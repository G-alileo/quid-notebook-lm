    {
      "parameters": {
        "jsCode": "const CHUNK_LIMIT = 96;\nconst record = $('Webhook').first().json.body.record;\nconst out = [];\nfor (const item of $input.all()) {\n  const chunks = item.json.chunks ?? [];\n  for (let i = 0; i < chunks.length; i += CHUNK_LIMIT) {\n    const slice = chunks.slice(i, i + CHUNK_LIMIT);\n    out.push({ json: { docId: record.id, userId: record.user_id, fullText: item.json.full_text ?? '', chunks: slice, texts: slice.map((c) => c.content) } });\n  }\n}\nif (out.length === 0) throw new Error('no chunks to embed');\nreturn out;"
      },
