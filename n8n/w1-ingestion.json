    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CHUNK_SIZE = 1000;\nconst CHUNK_OVERLAP = 200;\n\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 0x01000193) >>> 0;\n  }\n  return h.toString(16).padStart(8, '0');\n}\n\nfunction decodeBinary(binary) {\n  if (!binary || !binary.data || !binary.data.data) return null;\n  const buf = Buffer.from(binary.data.data, 'base64');\n  let text;\n  try {\n    text = buf.toString('utf8');\n  } catch (e) {\n    text = buf.toString('latin1');\n  }\n  if (/^%PDF/.test(text) || /[\\u0000-\\u0008\\u000e-\\u001f]/.test(text.slice(0, 2000))) {\n    throw new Error('binary payload reached Chunk content: PDF text extraction did not run for this item');\n  }\n  return text;\n}\n\nfunction makeChunks(text, sourceFile, sourceType, pageNumber, startIndex) {\n  const chunks = [];\n  let start = 0;\n  let index = startIndex;\n  while (start < text.length) {\n    let end = Math.min(start + CHUNK_SIZE, text.length);\n    if (end < text.length) {\n      const cand = Math.max(text.lastIndexOf('.', end - 1), text.lastIndexOf('\\n', end - 1));\n      if (cand >= start && cand > start + CHUNK_SIZE * 0.5) end = cand + 1;\n    }\n    const content = text.slice(start, end).trim();\n    if (content) {\n      const meta = {\n        source_file: sourceFile,\n        source_type: sourceType,\n        chunk_index: index,\n        start_char: start,\n        end_char: end - 1\n      };\n      if (pageNumber) meta.page_number = pageNumber;\n      meta.chunk_id = sourceType + '_' + index + '_' + fnv1a(content);\n      chunks.push({ content: content, meta: meta });\n      index++;\n    }\n    start = Math.max(start + CHUNK_SIZE - CHUNK_OVERLAP, end);\n    if (start >= text.length) break;\n  }\n  return chunks;\n}\n\nconst record = $('Webhook').first().json.body.record;\nconst items = $input.all();\nconst chunks = [];\nconst pages = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  let text = null;\n  if (j.content !== undefined) text = j.content;\n  else if (j.text !== undefined) text = j.text;\n  else if (j.data && j.data.markdown !== undefined) text = j.data.markdown;\n  if (text === null) text = decodeBinary(items[i].binary);\n  if (text === null || !String(text).trim()) continue;\n  text = String(text);\n  pages.push(text.trim());\n  const pageNumber = record.type === 'pdf' ? i + 1 : undefined;\n  const made = makeChunks(text, record.name, record.type, pageNumber, chunks.length);\n  for (const c of made) chunks.push(c);\n}\n\nif (chunks.length === 0) throw new Error('no extractable text found');\nreturn [{ json: { chunks: chunks, full_text: pages.join('\\n\\n') } }];"
      },
