    {
      "parameters": {
        "jsCode": "const preparedAll = $('Prepare batches').all();\nconst embedAll = $input.all();\nconst rows = [];\nfor (let k = 0; k < embedAll.length; k++) {\n  const prepared = preparedAll[k].json;\n  const embeddings = embedAll[k].json.embeddings ?? [];\n  prepared.chunks.forEach((chunk, i) => {\n    if (!embeddings[i]) throw new Error('embedding count mismatch');\n    rows.push({ content: chunk.content, embedding: '[' + embeddings[i].join(',') + ']', meta: chunk.meta });\n  });\n}\nconst first = preparedAll[0].json;\nreturn [{ json: { docId: first.docId, userId: first.userId, count: rows.length, fullText: first.fullText ?? '', rowsJson: JSON.stringify(rows) } }];"
      },
      "id": "502659de-1f3a-4a9d-9bad-54f51cf58c49",
